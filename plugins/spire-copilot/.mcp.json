{
  "mcpServers": {
    "spire_copilot": {
      "command": "node",
      "args": [
        "./scripts/server.mjs"
      ],
      "env": {
        "STS_MCP_URL": "http://127.0.0.1:8080/mcp"
      },
      "cwd": "${PLUGIN_ROOT}",
      "enabled": true,
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 60,
      "default_tools_approval_mode": "approve"
    }
  }
}


